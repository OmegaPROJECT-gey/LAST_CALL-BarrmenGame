{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "economy.schema.json",
	"title": "LAST CALL suppliers",
	"type": "object",
	"required": ["suppliers"],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"suppliers": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"type": "object",
				"required": ["display_name", "tier", "price_mult", "stock_limit", "night_risk", "sells"],
				"additionalProperties": false,
				"properties": {
					"display_name": { "$ref": "#/$defs/localized" },
					"tier": { "type": "string", "enum": ["cheap", "standard", "premium"] },
					"price_mult": { "type": "number", "exclusiveMinimum": 0 },
					"stock_limit": { "type": "integer", "minimum": 0 },
					"night_risk": { "type": "number", "minimum": 0, "maximum": 1 },
					"sells": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"items": { "type": "string", "minLength": 1 }
					}
				}
			}
		}
	},
	"$defs": {
		"localized": {
			"type": "object",
			"required": ["en", "ru"],
			"additionalProperties": false,
			"properties": {
				"en": { "type": "string", "minLength": 1 },
				"ru": { "type": "string", "minLength": 1 }
			}
		}
	}
}
