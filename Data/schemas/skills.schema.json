{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "skills.schema.json",
	"title": "LAST CALL bartender skill tree",
	"type": "object",
	"required": ["branches"],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"branches": {
			"type": "object",
			"required": ["flair", "psychology", "steady_hands", "alchemy"],
			"additionalProperties": false,
			"properties": {
				"flair": { "$ref": "#/$defs/branch" },
				"psychology": { "$ref": "#/$defs/branch" },
				"steady_hands": { "$ref": "#/$defs/branch" },
				"alchemy": { "$ref": "#/$defs/branch" }
			}
		}
	},
	"$defs": {
		"localized": {
			"type": "object",
			"required": ["en", "ru"],
			"additionalProperties": false,
			"properties": {
				"en": { "type": "string", "minLength": 1 },
				"ru": { "type": "string", "minLength": 1 }
			}
		},
		"node": {
			"type": "object",
			"required": ["id", "cost", "requires", "effect"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
				"cost": { "type": "integer", "minimum": 0 },
				"requires": { "type": "array", "items": { "type": "string" } },
				"effect": {
					"type": "object",
					"required": ["type"],
					"properties": {
						"type": { "type": "string" },
						"mult": { "type": "number" },
						"ids": { "type": "array", "items": { "type": "string" } }
					}
				}
			}
		},
		"branch": {
			"type": "object",
			"required": ["display_name", "nodes"],
			"additionalProperties": false,
			"properties": {
				"display_name": { "$ref": "#/$defs/localized" },
				"nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
			}
		}
	}
}
